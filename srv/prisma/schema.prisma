generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model Role {
  roleId   Int           @id @default(autoincrement()) @map("role_id")
  roleName String        @map("role_name") @db.VarChar(50)
  users    UserProfile[]

  @@map("role")
}

model Education {
  educationId Int           @id @default(autoincrement()) @map("education_id")
  university  String        @db.VarChar(100)
  faculty     String        @db.VarChar(100)
  major       String        @db.VarChar(100)
  users       UserProfile[]

  @@map("education")
}

model UserProfile {
  userId            Int                   @id @default(autoincrement()) @map("user_id")
  username          String                @db.VarChar(100)
  password          String                @db.VarChar(255)
  firstName         String                @map("first_name") @db.VarChar(100)
  lastName          String                @map("last_name") @db.VarChar(100)
  email             String                @unique @db.VarChar(150)
  gender            String                @db.VarChar(10)
  dateOfBirth       DateTime              @map("date_of_birth") @db.Date
  educationId       Int                   @map("education_id")
  roleId            Int                   @map("role_id")
  registerTimestamp DateTime              @default(now()) @map("register_timestamp") @db.Timestamp(6)
  lastActiveAt      DateTime?             @map("last_active_at") @db.Timestamp(6)
  activities        Activity[]
  education         Education             @relation(fields: [educationId], references: [educationId], onDelete: NoAction, onUpdate: NoAction)
  role              Role                  @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  userSessions      UserSessionProgress[]
  auditLogs         AuditLog[]

  @@map("user_profile")
}

model AuditLog {
  id         Int          @id @default(autoincrement())
  userId     Int?         @map("user_id")
  username   String?      @db.VarChar(100)
  action     String       @db.VarChar(100) // เช่น CREATE_EXERCISE, UPDATE_USER, LOGIN
  entity     String       @db.VarChar(100) // เช่น Exercise, UserProfile, Session
  entityId   Int?         @map("entity_id")
  details    Json?        // เก็บ payload หรือ { oldData, newData }
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(6)

  user       UserProfile? @relation(fields: [userId], references: [userId], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Exercise {
  exerciseId       Int               @id @default(autoincrement()) @map("exercise_id")
  title            String            @db.VarChar(255)
  description      String
  topic            String            @db.VarChar(100)
  objective        String
  difficultyLevel  Int               @map("difficulty_level")
  expectedTime     Int               @map("expected_time")
  status           String            @db.VarChar(50)
  hint             String
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  activities       Activity[]
  sessionExercises SessionExercise[]

  @@map("exercise")
}

model Session {
  sessionId        Int                   @id @default(autoincrement()) @map("session_id")
  sessionName      String                @map("session_name") @db.VarChar(100)
  sessionObjective String                @map("session_objective") @db.VarChar(100)
  targetLevel      Int                   @map("target_level")
  duration         Int
  status           String                @db.VarChar(50)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  activities       Activity[]
  sessionExercises SessionExercise[]
  userSessions     UserSessionProgress[]

  @@map("session")
}

model SessionExercise {
  sessionId     Int      @map("session_id")
  exerciseId    Int      @map("exercise_id")
  sequenceOrder Int      @default(1) @map("sequence_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  exercise      Exercise @relation(fields: [exerciseId], references: [exerciseId], onDelete: Cascade, onUpdate: NoAction)
  session       Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, exerciseId])
  @@map("session_exercise")
}

model UserSessionProgress {
  userId      Int         @map("user_id")
  sessionId   Int         @map("session_id")
  status      String      @default("IN_PROGRESS") @db.VarChar(50)
  startedAt   DateTime    @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt DateTime?   @map("completed_at") @db.Timestamp(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  session     Session     @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: NoAction)
  user        UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, sessionId])
  @@map("user_session_progress")
}

model Activity {
  activityId       Int         @id @default(autoincrement()) @map("activity_id")
  userId           Int         @map("user_id")
  exerciseId       Int         @map("exercise_id")
  sessionId        Int         @map("session_id")
  startedAt        DateTime    @map("started_at") @db.Timestamp(6)
  submittedAt      DateTime    @default(now()) @map("submitted_at") @db.Timestamp(6)
  hintUsed         Boolean     @default(false) @map("hint_used")
  answer           String
  score            Int
  status           String      @default("PENDING") @db.VarChar(50)
  output           String?     @map("output")
  exceptionMessage String?     @map("exception_message")
  aiFeedback       String?     @map("ai_feedback")
  eventType        String      @map("event_type") @db.VarChar(50)
  runCount         Int         @map("run_count")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  exercise         Exercise    @relation(fields: [exerciseId], references: [exerciseId], onDelete: Cascade, onUpdate: NoAction)
  session          Session     @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: NoAction)
  user             UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("activity")
}
