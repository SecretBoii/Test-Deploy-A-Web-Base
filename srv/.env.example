# ==========================================
# Database Connection (PostgreSQL / Supabase)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/python_exercises?schema=public"

# ==========================================
# Authentication & Security
# ==========================================
# JWT Secret Key ที่แข็งแรงและปลอดภัย
JWT_SECRET="your_strong_jwt_secret_key_change_me_in_production"
# กำหนดโดเมนที่อนุญาตให้เรียกใช้ API (คั่นด้วยจุลภาค)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost"
# บังคับเปิด Secure Cookie เมื่อใช้งานหลัง HTTPS (ค่าที่เป็นไปได้: true หรือ false)
COOKIE_SECURE="false"

# ==========================================
# Background Queue (Redis for BullMQ)
# ==========================================
REDIS_HOST="redis"
REDIS_PORT=6379

# ==========================================
# AI Evaluation (PSU Gemma Model)
# ==========================================
GEMMA_PSU="YOUR_PSU_GEMMA_API_KEY"
GEMMA_MODEL="PSU-LLM/psu-gemma"
GEMMA_API_URL="https://ai.psu.blue/v1/chat/completions"

# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV="production"
